APP_ENV=local

# DB
DATABASE_URL=postgresql+psycopg://drawtale:drawtale@127.0.0.1:5433/drawtale

# AI
#   AI_USE_MOCK=true  : AI 서버 없이 가짜 결과로 동작 (Frontend 화면 개발용)
#   AI_USE_MOCK=false : 실제 AI 서버 사용 (drawtale-ai를 먼저 띄워야 함)
AI_SERVICE_URL=http://127.0.0.1:8001
AI_USE_MOCK=true
# 애니메이션 렌더링에 20~40초가 걸리므로 넉넉하게 둔다
AI_TIMEOUT_SECONDS=300

# Storage (local: files saved under LOCAL_STORAGE_DIR and served at /files)
PUBLIC_BASE_URL=http://127.0.0.1:8000
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
# 「원본 그림 보관」을 끈 그림을 지우라는 요청이 없어도 이 시간 뒤 지운다
ORIGINAL_RETENTION_HOURS=24
#   STORAGE_BACKEND=azure 로 바꾸면 아래 두 값이 필요하다 (Backend 담당에게 받는다)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=drawtale-dev
AZURE_SAS_HOURS=2

# External API
#   키가 비어 있으면 이야기는 템플릿 문장으로 대체된다 (서비스는 계속 동작)
OPENAI_API_KEY=
OPENAI_TIMEOUT_SECONDS=30
#   비어 있으면 OPENAI_API_KEY를 그대로 사용한다
TTS_API_KEY=
TTS_TIMEOUT_SECONDS=60
#   이야기 음성 업체: openai (기본, 위 키 사용) | elevenlabs (아래 셋 필요)
TTS_PROVIDER=openai
#   키는 여기에만 둔다. 채팅·문서·커밋에 붙이지 않는다
ELEVENLABS_API_KEY=
#   ElevenLabs 콘솔 Voices 에서 고른 목소리의 id
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Social login — 각 개발자 콘솔에서 발급. 동의 항목(scope)은 켜지 않는다: 회원번호만 받는다
#   Redirect URI: http://localhost:5173/auth/{kakao|google}/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_TOKEN_DAYS=30

# Web (comma separated) — Frontend 개발 서버 주소를 등록해야 호출이 된다
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
