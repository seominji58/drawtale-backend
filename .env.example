APP_ENV=local

# DB
DATABASE_URL=postgresql+psycopg://drawtale:drawtale@127.0.0.1:5433/drawtale

# AI
#   AI_USE_MOCK=true  : AI 서버 없이 가짜 결과로 동작 (Frontend 화면 개발용)
#   AI_USE_MOCK=false : 실제 AI 서버 사용 (drawtale-ai를 먼저 띄워야 함)
AI_SERVICE_URL=http://127.0.0.1:8001
AI_USE_MOCK=true
# 애니메이션 렌더링에 20~40초가 걸리므로 넉넉하게 둔다
AI_TIMEOUT_SECONDS=300

# Storage (local: files saved under LOCAL_STORAGE_DIR and served at /files)
PUBLIC_BASE_URL=http://127.0.0.1:8000
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
# 「원본 그림 보관」을 끈 그림을 지우라는 요청이 없어도 이 시간 뒤 지운다
ORIGINAL_RETENTION_HOURS=24
#   STORAGE_BACKEND=azure 로 바꾸면 아래 두 값이 필요하다 (Backend 담당에게 받는다)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=drawtale-dev
AZURE_SAS_HOURS=2

# External API
#   키가 비어 있으면 이야기는 템플릿 문장으로 대체된다 (서비스는 계속 동작)
OPENAI_API_KEY=
OPENAI_TIMEOUT_SECONDS=30
# 긴 이야기(length=long)의 쪽 수. 7~11 (2026-10-12, 쪽 수는 아직 정하지 않음)
STORY_PAGES=8
# 긴 이야기 대본: Claude 가 먼저(2026-10-27). 키가 없거나 실패하면 STORY_BOOK_MODEL(OpenAI), 그것도 안 되면 틀 문장.
#   검열은 OpenAI 라서 OPENAI_API_KEY 는 그대로 필요하다. 키는 여기에만 둔다
STORY_BOOK_PROVIDER=anthropic
ANTHROPIC_API_KEY=
STORY_BOOK_CLAUDE_MODEL=claude-opus-5-5
STORY_BOOK_EFFORT=medium
# OpenAI 대신 모델 (gpt-4o-mini 는 카드 뜻을 뒤집는 일이 있었다, 2026-10-12)
STORY_BOOK_MODEL=gpt-5.4-mini
#   비어 있으면 OPENAI_API_KEY를 그대로 사용한다
TTS_API_KEY=
TTS_TIMEOUT_SECONDS=60
#   이야기 음성 업체: openai (기본, 위 키 사용) | elevenlabs (아래 셋 필요)
TTS_PROVIDER=openai
#   키는 여기에만 둔다. 채팅·문서·커밋에 붙이지 않는다
ELEVENLABS_API_KEY=
#   ElevenLabs 콘솔 Voices 에서 고른 목소리의 id. 팀 가안은 Anna Kim (한국어, 이야기 낭독용)
#   다른 계정이면 Voice Library 에서 「Anna Kim」을 내 목소리로 추가한다
ELEVENLABS_VOICE_ID=uyVNoMrnUku1dZyVEXwD
ELEVENLABS_MODEL_ID=eleven_v4_turbo
# 쪽 음성 동시 처리 (Turbo · Flash 기준 Starter 6 · Creator 10 에서 하나 남김). Creator 면 9
PAGE_AUDIO_WORKERS=5
#   캐릭터 목소리 판(voice_mode=characters)의 인물 목소리는 app/services/voices.py 에 있다
# 녹음 목소리(보호자 · 아이) 업체: elevenlabs (기본) | qwen (자체 서버 drawtale-tts, Modal GPU)
#   qwen 이면 녹음 목소리는 나레이션만, 기본 나레이터와 캐릭터 대사는 위 ElevenLabs 가 그대로 읽는다
GUARDIAN_VOICE_PROVIDER=elevenlabs
#   아이 목소리만 따로 (비우면 위와 같다). 예: 보호자는 elevenlabs, 아이는 qwen
CHILD_VOICE_PROVIDER=
#   qwen 일 때 필요. 주소 · 토큰은 TTS 담당에게 받는다 (modal deploy 주소). 토큰은 여기에만 둔다
QWEN_TTS_URL=
QWEN_TTS_TOKEN=
QWEN_TTS_TIMEOUT_SECONDS=180

# Social login — 각 개발자 콘솔에서 발급. 동의 항목(scope)은 켜지 않는다: 회원번호만 받는다
#   Redirect URI: http://localhost:5173/auth/{kakao|google}/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_TOKEN_DAYS=30

# 보호자 본인인증 (포트원 V2 + KG이니시스, 만 14세 이상, 가입할 때 한 번). app/services/identity.py
#   admin.portone.io → 결제 연동 → 연동 정보 → API Keys 의 V2 API Secret. 상점 아이디는 조회에 같이 보낸다
#   프론트 .env 에는 상점 아이디 · 본인인증 채널 키(공개 값)를 둔다
#   AGE_VERIFICATION_REQUIRED 를 비우면: PORTONE_API_SECRET 이 있을 때만 가입에 요구한다
PORTONE_API_SECRET=
PORTONE_STORE_ID=
AGE_VERIFICATION_REQUIRED=

# 비용이 드는 요청의 횟수 제한 (app/core/rate_limit.py). 부하 시험 때만 끈다
RATE_LIMIT_ENABLED=true

# Web (comma separated) — Frontend 개발 서버 주소를 등록해야 호출이 된다
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
