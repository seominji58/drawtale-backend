APP_ENV=local

# DB
DATABASE_URL=postgresql+psycopg://drawtale:drawtale@127.0.0.1:5433/drawtale

# AI
AI_SERVICE_URL=http://127.0.0.1:8001
AI_USE_MOCK=true
AI_TIMEOUT_SECONDS=60

# Storage (local: files saved under LOCAL_STORAGE_DIR and served at /files)
PUBLIC_BASE_URL=http://127.0.0.1:8000
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
AZURE_STORAGE_CONNECTION_STRING=
BLOB_CONTAINER_UPLOADS=dev-uploads
BLOB_CONTAINER_RESULTS=dev-results

# External API
OPENAI_API_KEY=
TTS_API_KEY=

# Web (comma separated)
CORS_ORIGINS=http://localhost:5173
