# 배포용 설정. 이 파일을 .env.prod 로 복사해 값을 채운다.
# **.env.prod 는 깃에 올리지 않는다.**

APP_ENV=prod

# ---- 보안 (2026-11-02) ----
# APP_ENV=prod 면 API 문서(/docs)는 저절로 꺼진다
# 손님 주소는 uvicorn --proxy-headers 로 받는다 (docker-compose.prod.yml)
# 이야기 하루 한도 (기본값). 유료 API(Claude · ElevenLabs)를 막는 둑이라 대회 · 시연 규모에 맞춰 조정.
# 분당 · 동시 제한은 app/core/rate_limit.py
# GUEST_STORIES_PER_DAY=30
# MEMBER_STORIES_PER_DAY=60
# MAX_STORIES_PER_DAY=1000

# Azure Database for PostgreSQL. VM 의 공인 IP 를 방화벽에 등록해야 닿는다
DATABASE_URL=postgresql+psycopg://사용자:비밀번호@서버.postgres.database.azure.com:5432/drawtale?sslmode=require

# 컨테이너 이름으로 부른다. 127.0.0.1 이 아니다
AI_SERVICE_URL=http://ai:8001
AI_USE_MOCK=false
# **렌더 실측 47.5초** (20코어 PC, 2026-10-13). 60초로 두면 VM 이 느릴 때 끊긴다
AI_TIMEOUT_SECONDS=120

# 바깥에서 보이는 주소. 파일 주소를 만들 때 쓴다
PUBLIC_BASE_URL=https://api.drawtale.kr

# 로컬 디스크를 쓰면 컨테이너를 지울 때 올린 그림이 사라진다
# VM 디스크(볼륨)에 둔다 (서민지 님 95c18b0). 파일 주소는 서명 · 기한이 붙어야 열린다 (2026-11-02)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/app/storage
# **꼭 긴 무작위 값을 넣는다** (예: python -c "import secrets; print(secrets.token_hex(32))").
# 비우면 서버를 다시 켤 때마다 바뀌어, 그 전에 내준 그림 · 음성 주소가 열리지 않는다
FILE_URL_SECRET=
# 파일 주소가 열리는 시간
FILE_URL_HOURS=24
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=drawtale-prod
AZURE_SAS_HOURS=2

OPENAI_API_KEY=
STORY_BOOK_PROVIDER=anthropic
ANTHROPIC_API_KEY=
STORY_BOOK_CLAUDE_MODEL=claude-opus-5-5
STORY_BOOK_EFFORT=medium
STORY_BOOK_MODEL=gpt-5.4-mini
STORY_PAGES=8

TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v4_turbo

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 프론트 주소로 바꾼다. 로컬 주소를 남겨 두면 안 된다
CORS_ORIGINS=https://www.drawtale.kr
