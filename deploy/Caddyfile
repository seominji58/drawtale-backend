# 타임아웃은 사이트 안이 아니라 전역 설정에만 쓸 수 있다
{
	servers {
		timeouts {
			read_body 2m
			write 2m
		}
	}
}

# 화면은 www.drawtale.kr, API 는 이 주소다. DNS A 레코드가 VM 을 가리키면 HTTPS 인증서를 자동으로 받는다.
api.drawtale.kr {
	reverse_proxy backend:8000

	# 올리는 그림이 10MB 까지라 여유를 둔다 (MAX_UPLOAD_MB)
	request_body {
		max_size 20MB
	}

	encode gzip
	log {
		output stdout
	}
}

# 화면도 이 VM 이 준다. 빌드 결과는 deploy/www 에 둔다 (README)
www.drawtale.kr {
	root * /srv/www
	try_files {path} /index.html
	file_server
	encode gzip
}

drawtale.kr {
	redir https://www.drawtale.kr{uri} permanent
}
